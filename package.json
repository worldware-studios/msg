{
  "name": "@worldware/msg",
  "version": "0.6.4",
  "description": "Message localization tooling",
  "license": "MIT",
  "author": "Joel Sahleen",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldware-studios/msg"
  },
  "bugs": {
    "url": "https://github.com/worldware-studios/msg/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/typescript": "^0.4.29",
    "@vitest/coverage-v8": "^4.0.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "messageformat": "4.0.0-10",
    "pseudo-localization": "^2.4.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  }
}
