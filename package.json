{
  "name": "@worldware/msg",
  "version": "0.7.1",
  "description": "Message localization tooling",
  "license": "MIT",
  "author": "Joel Sahleen",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldware-studios/msg"
  },
  "bugs": {
    "url": "https://github.com/worldware-studios/msg/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/typescript": "^0.4.29",
    "@vitest/coverage-v8": "^4.0.15",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@messageformat/icu-messageformat-1": "^0.12.0",
    "messageformat": "^4.0.0",
    "pseudo-localization": "^2.4.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "typedoc src/index.ts"
  }
}
